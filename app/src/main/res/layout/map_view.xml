<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.yandex.mapkit.mapview.MapView
        android:id="@+id/mapview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/top_filters_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_margin="16dp"
        android:background="@drawable/info_background1"
        android:orientation="vertical"
        android:padding="12dp"
        android:elevation="8dp">

        <EditText
            android:id="@+id/search_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Поиск по названию или услуге"
            android:inputType="text"
            android:maxLines="1"
            android:padding="12dp"
            android:textColor="#101010"
            android:textColorHint="#BBBBBB" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/category_chip_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleSelection="false"
            app:selectionRequired="false">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_all"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Все"
                android:checked="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_sto"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="СТО" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_tire"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Шиномонтаж" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_bodywork"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Кузовной" />
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_pound"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Штрафстоянки" />
        </com.google.android.material.chip.ChipGroup>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/info_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="0dp"
        android:layout_marginBottom="52dp"
        android:background="@drawable/info_background1"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/close_button"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="end|top"
            android:contentDescription="Close"
            android:src="@android:drawable/ic_menu_close_clear_cancel" />
        //крестик значок

        <TextView
            android:id="@+id/company_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#0C0C0C"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/services"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#050505"
            android:textSize="15sp" />

        <Button
            android:id="@+id/nav_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/round_button_background"
            android:layout_marginTop="12dp"
            android:text="Проложить маршрут" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/map_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="16dp"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/location_button"
            android:layout_width="53dp"
            android:layout_height="53dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/round_button_background"
            android:contentDescription="Моё местоположение"
            android:padding="12dp"
            android:src="@drawable/ic_home_black_24dp" />
        //локация

        <ImageView
            android:id="@+id/zoom_in_button"
            android:layout_width="53dp"
            android:layout_height="53dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/round_button_background"
            android:padding="12dp"
            android:src="@drawable/baseline_zoom_in_24" />

        <ImageView
            android:id="@+id/zoom_out_button"
            android:layout_width="53dp"
            android:layout_height="53dp"
            android:background="@drawable/round_button_background"
            android:padding="12dp"
            android:src="@drawable/baseline_zoom_out_24" />
    </LinearLayout>

</RelativeLayout>